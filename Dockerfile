# Образ для нашего бэкенда. Беру python:3.11-slim — он маленький и его
# не надо отдельно объяснять.
FROM python:3.11-slim

WORKDIR /app

# Сначала только requirements.txt — так Docker закэширует pip install
# отдельным слоем и не будет переустанавливать зависимости при каждой
# правке кода, только когда меняются сами зависимости.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Дальше весь остальной код: app/, model/, planner/, data/ (сценарии
# нужны прямо в образе — сервис их читает с диска по scenario_id).
COPY . .

# Сессии и кастомные сценарии живут только в памяти процесса (см.
# app/server.py — SESSIONS и CUSTOM_SCENARIOS это обычные dict, никакой
# записи на диск во время работы нет), так что образ спокойно работает и
# на хостингах с доступной на запись только временной файловой системой.
ENV PYTHONUNBUFFERED=1

EXPOSE 8000

# $PORT подставляет хостинг (Render и подобные) — если переменной нет,
# слушаем 8000 сами. Через sh -c, чтобы подстановка ${PORT:-8000} реально
# отработала (в exec-форме CMD без шелла переменные так не разворачиваются).
CMD ["sh", "-c", "uvicorn app.server:app --host 0.0.0.0 --port ${PORT:-8000}"]

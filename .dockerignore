# В образ кладём только то, что реально нужно сервису для работы:
# app/, model/, planner/, data/ (сценарии сервис читает с диска) и
# requirements.txt. Всё остальное — только раздувает образ.
.git
.gitignore
.dockerignore
__pycache__/
**/__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
.DS_Store

# организаторские PDF, наши тесты, примеры событий и моки для фронта —
# сервису на рантайме не нужны
docs/
tests/
examples/
app/mock/

# результаты прогонов — тяжёлые и не нужны для работы сервиса
results/
